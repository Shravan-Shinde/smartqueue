# SmartQueue Centralized Environment Variables Template
# Copy to .env for custom local development or cloud deployment configurations

# Backend Service Configuration
PORT=5000
NODE_ENV=production

# Managed Database Configuration (MongoDB Source of Truth)
# Example Local: mongodb://mongodb:27017/smartqueue
# Example Managed Atlas: mongodb+srv://<db_user>:<db_pass>@cluster.mongodb.net/smartqueue?retryWrites=true&w=majority
MONGO_URI=mongodb://mongodb:27017/smartqueue

# Managed Redis & BullMQ Configuration
# Example Local: redis://redis:6379
# Example Managed Cloud Redis: rediss://:<password>@redis-instance.provider.com:6379
REDIS_URL=redis://redis:6379

# Security & Authentication
JWT_SECRET=smartqueue_jwt_secret_dev_key_2026
COOKIE_SAME_SITE=lax
# Google Identity OAuth 2.0 Credentials (Set in backend and frontend)
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# CORS Authorization
CLIENT_URL=http://localhost:8080

# Frontend Build Time Arguments (Exposed to Vite bundle)
VITE_API_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

